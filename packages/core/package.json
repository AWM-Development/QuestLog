		"ci-gate-guard": "tsx src/ci/gate-guard.ts",
		"ci-scope-guard": "tsx src/ci/scope-guard.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.79.0",
		"@questlog/shared": "workspace:*",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"mammoth": "^1.12.0",
		"pdf-parse": "^2.4.5",
		"postgres": "^3.4.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.13.10",
		"@types/pdf-parse": "^1.1.5",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"vitest": "^3.0.9"
	}
