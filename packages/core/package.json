{
	"name": "@questlog/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*"
	},
	"scripts": {
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"typecheck": "tsc --noEmit",
