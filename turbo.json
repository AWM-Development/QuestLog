{
  "$schema": "https://v2-9-4.turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["ANTHROPIC_API_KEY", "VOYAGE_API_KEY"]
    },
    "lint": {},
    "typecheck": {}
  }
}
