# Database
DATABASE_URL=postgresql://questlog:questlog@localhost:5433/questlog

# API server listen port (default 3000). If you change this, update VITE_API_URL below.
# PORT=3000

# Frontend API URL (must be prefixed with VITE_ for Vite to expose it)
VITE_API_URL=http://localhost:3000/trpc

# CORS origin for the API server (omit for dev to allow all origins)
# CORS_ORIGIN=https://questlog.example.com

# Anthropic API (agent conversation)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (embeddings — recommended by Anthropic)
VOYAGE_API_KEY=pa-...
