{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022"],
		"paths": {
			"@questlog/shared": ["../../packages/shared/src"],
			"@questlog/core": ["../../packages/core/src"],
			"@questlog/core/*": ["../../packages/core/src/*"],
			"@questlog/mcp": ["../../packages/mcp/src"],
			"@questlog/mcp/*": ["../../packages/mcp/src/*"],
			// query-lore.e2e.test.ts is the only remaining reason for this: it
			// needs apps/server's buildApp, which isn't a package export. Leaf
			// app, no cycle risk (nothing depends on apps/mcp-stdio).
			"@questlog/server/*": ["../../apps/server/src/*"]
		}
	},
	"include": ["src"]
}
