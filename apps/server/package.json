{
	"name": "@questlog/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=../../.env src/main.ts",
		"build": "node scripts/build.mjs",
		"process-imports": "tsx --env-file=../../.env src/process-imports.ts",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.79.0",
		"@fastify/cors": "^11.2.0",
		"@fastify/multipart": "^9.0.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@questlog/shared": "workspace:*",
		"@trpc/server": "^11.0.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"fastify": "^5.2.1",
		"mammoth": "^1.12.0",
		"pdf-parse": "^2.4.5",
		"postgres": "^3.4.8",
		"superjson": "^2.2.6",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.13.10",
		"@types/pdf-parse": "^1.1.5",
		"drizzle-kit": "^0.31.9",
		"esbuild": "^0.28.1",
		"form-data": "^4.0.5",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"vitest": "^3.0.9"
	}
}
