{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "api-server",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--filter", "@questlog/server", "dev"],
			"port": 3000
		},
		{
			"name": "web-client",
			"runtimeExecutable": "/bin/bash",
			"runtimeArgs": ["-c", "source ~/.nvm/nvm.sh && nvm use 24 && pnpm --filter @questlog/web dev"],
			"port": 5173
		}
	]
}
