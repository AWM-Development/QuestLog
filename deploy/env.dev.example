# apps/server — DEV environment secrets/config.
# Names and structure only — NEVER commit real values. Set these on the real
# Fly app with:
#   fly secrets set -c fly.dev.toml DATABASE_URL=... ANTHROPIC_API_KEY=... VOYAGE_API_KEY=...
# See Docs/DEPLOY_SETUP_CHECKLIST.md for the full manual sequence.

# Neon connection string for this project's CHILD branch (dev data, not
# prod's root branch) — Docs/DEPLOY_READINESS.md §2.3.
DATABASE_URL=postgresql://<user>:<password>@<dev-branch-host>.neon.tech/questlog?sslmode=require

# Anthropic API (agent conversation) — same key can be reused across dev/prod
# unless Alex wants separate usage tracking per environment.
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (embeddings)
VOYAGE_API_KEY=pa-...

# CORS origin for apps/web's SourcesPage talking to this dev server — set to
# wherever dev's frontend is actually served from, or omit to allow all
# origins (acceptable for a non-production environment).
# CORS_ORIGIN=https://dev.questlog.example.com

# PORT is set directly in fly.dev.toml's [env] block (not a secret) — listed
# here only so this file documents every var apps/server reads.
PORT=3000
