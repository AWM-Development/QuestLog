# apps/server — PROD environment secrets/config.
# Names and structure only — NEVER commit real values. Set these on the real
# Fly app with:
#   fly secrets set -c fly.prod.toml DATABASE_URL=... ANTHROPIC_API_KEY=... VOYAGE_API_KEY=...
# See Docs/DEPLOY_SETUP_CHECKLIST.md for the full manual sequence.

# Neon connection string for this project's ROOT branch (real campaign data —
# Docs/DEPLOY_READINESS.md §2.3 and §2.4's "irreplaceable campaign lore"
# framing: double-check this is the root branch, not a dev child branch).
DATABASE_URL=postgresql://<user>:<password>@<prod-branch-host>.neon.tech/questlog?sslmode=require

# Anthropic API (agent conversation)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (embeddings)
VOYAGE_API_KEY=pa-...

# CORS origin for apps/web's SourcesPage — set to the real deployed frontend
# origin. Do not leave unset in prod the way dev may (unset allows all
# origins).
CORS_ORIGIN=https://questlog.example.com

# PORT is set directly in fly.prod.toml's [env] block (not a secret) — listed
# here only so this file documents every var apps/server reads.
PORT=3000
